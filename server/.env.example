# Meta (WhatsApp + Instagram)
META_VERIFY_TOKEN=cambiar_este_token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_IG_PAGE_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (audio transcription)
OPENAI_API_KEY=

# Tienda Nube (pedidos, stock y productos — entreno.com.ar)
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_STORE_ID=

# Mercado Libre (integración en desarrollo, ver mercadolibre.service.js —
# esqueleto sin implementar todavía, dejadas las 4 vacías no rompe nada).
# Se obtienen creando una app en https://developers.mercadolibre.com.ar y
# completando el flujo OAuth una vez para conseguir el refresh_token inicial.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REFRESH_TOKEN=
MERCADOLIBRE_SELLER_ID=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Auth
JWT_SECRET=
# Cuenta admin sembrada al primer arranque. Completar antes del primer boot.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# App
PORT=3001
NODE_ENV=development

# Set to the deployed Vercel dashboard URL(s) (comma-separated) so the backend's
# CORS allowlist accepts requests from it in production (Railway backend + Vercel frontend).
FRONTEND_URL=

# URL pública de ESTE backend (ej. https://bot-entreno-production.up.railway.app,
# sin barra final) — se usa para armar los links cortos de tracking de clicks
# en las difusiones (GET /r/:code). Si queda vacío, las difusiones mandan el
# link de destino directo, sin trackear clicks.
PUBLIC_BASE_URL=
